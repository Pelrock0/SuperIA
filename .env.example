APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost


LOGIN_DOUBLE_AUTH_ENABLED=true

BASSET_DEV_MODE=false

TELESCOPE_ENABLED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database


PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@superia.app"
MAIL_FROM_NAME="Superia"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=43200

AI_PROVIDER=claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
AI_TIMEOUT=30
AI_BUDGET_CAP_MONTHLY_USD=50
AI_ADMIN_ALERT_EMAIL=
AI_FREE_SUGGESTIONS_PER_DAY=20
AI_TIMEZONE=Europe/Madrid

AI_GENERATION_MODEL=claude-sonnet-4-6
AI_GENERATION_PER_DAY=5

AI_WEEKLY_SUMMARY_ENABLED=true
AI_WEEKLY_SUMMARY_MODEL=claude-haiku-4-5-20251001

WEBAUTHN_ENABLED=false
WEBAUTHN_RP_ID=superia.com.local
WEBAUTHN_RP_NAME=Superia
WEBAUTHN_ORIGINS=http://superia.com.local,http://localhost,http://127.0.0.1

VITE_APP_NAME="${APP_NAME}"
