    "https://www.gravatar.com/avatar/5edfa2692bdacc5e6ee805c626c50cb44cebb065f092d9a1067d89f74dacd326.jpg?s=80&d=blank&r=g": {
        "asset_name": "https://www.gravatar.com/avatar/5edfa2692bdacc5e6ee805c626c50cb44cebb065f092d9a1067d89f74dacd326.jpg?s=80&d=blank&r=g",
